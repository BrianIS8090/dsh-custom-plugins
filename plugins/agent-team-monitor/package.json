{
  "name": "@local/agent-team-monitor",
  "version": "1.1.14",
  "private": true,
  "description": "Live Agent Teams dashboard with member activity, peer messages, token usage, and active time.",
  "scripts": {
    "test": "node --test --test-isolation=none test/projection.test.js test/schema.test.js && node test/static-validation.cjs && node test/canvas-validation.cjs && node test/chat-scroll.cjs"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./projection": "./projection.js",
    "./schema": "./schema.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "projection.js",
    "schema.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
