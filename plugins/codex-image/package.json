{
  "name": "@local/codex-image",
  "version": "1.0.0",
  "private": true,
  "description": "Генерация и редактирование изображений моделью gpt-image (Codex) через OpenAI-совместимый CLIProxyAPI, с настройками на странице плагина.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/core.js",
    "lib/config.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "INSTALL.md"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/core.js && node --check lib/config.js && node --check lib/client.js",
    "test": "node --test test/*.test.mjs"
  },
  "engines": { "dsh": ">=0.2.2-rc.1 <0.3.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
