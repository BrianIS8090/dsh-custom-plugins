{
  "name": "@local/russian-kanban",
  "version": "1.0.1",
  "private": true,
  "description": "Русская доска задач DSH с полным доступом агента и выбором карточек по * в чате.",
  "type": "module",
  "engines": {
    "dsh": "0.2.2-rc.3"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "search.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "UPSTREAM-NOTICE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check index.js && node --check lib/client.js && node scripts/check-client-bundle.mjs && node scripts/check-locale.mjs && node scripts/check-pipeline.mjs",
    "check:client-bundle": "node scripts/check-client-bundle.mjs",
    "check:locale": "node scripts/check-locale.mjs",
    "check:pipeline": "node scripts/check-pipeline.mjs",
    "test:unit": "vitest run",
    "test": "pnpm test:unit && pnpm check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-store"
      ]
    },
    "compatibility": {
      "dsh": "0.2.2-rc.3",
      "dshReleases": {
        "0.2.2-rc.3": "compatible"
      },
      "profiles": [
        "web",
        "desktop"
      ]
    }
  }
}
