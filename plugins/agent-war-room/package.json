{
  "name": "@local/agent-war-room",
  "version": "1.0.2",
  "private": true,
  "description": "Four-role Agent War Room with one live Markdown artifact, a unified decision feed, and source tracking.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./projection": "./projection.js",
    "./orchestrator": "./orchestrator.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "orchestrator.js",
    "projection.js",
    "schema.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none test/projection.test.js test/client-render.test.cjs && node test/static-validation.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "devDependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}
